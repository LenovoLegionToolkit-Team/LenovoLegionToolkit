<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custom="clr-namespace:LenovoLegionToolkit.WPF.Controls.Custom">

    <!--  ReSharper disable Xaml.StaticResourceNotResolved  -->

    <Style TargetType="{x:Type custom:RangeSlider}">
        <Setter Property="Height" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type custom:RangeSlider}">
                    <Canvas
                        x:Name="PART_Canvas"
                        Background="Transparent"
                        ClipToBounds="False">
                        <Border
                            x:Name="PART_Track"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="2">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" />
                            </Border.Background>
                        </Border>
                        <Border x:Name="PART_Selection" CornerRadius="2">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                            </Border.Background>
                        </Border>
                        <Thumb x:Name="PART_StartThumb" Style="{StaticResource UiSliderThumbStyle}" />
                        <Thumb x:Name="PART_StopThumb" Style="{StaticResource UiSliderThumbStyle}" />
                    </Canvas>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Track" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorSecondary}" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Track" Property="Opacity" Value="0.4" />
                            <Setter TargetName="PART_Selection" Property="Opacity" Value="0.4" />
                            <Setter TargetName="PART_StartThumb" Property="Opacity" Value="0.4" />
                            <Setter TargetName="PART_StopThumb" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ReSharper restore Xaml.StaticResourceNotResolved  -->

</ResourceDictionary>
