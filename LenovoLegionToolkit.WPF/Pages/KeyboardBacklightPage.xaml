<wpfui:UiPage
    x:Class="LenovoLegionToolkit.WPF.Pages.KeyboardBacklightPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LenovoLegionToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:LenovoLegionToolkit.WPF.Controls.Custom"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:LenovoLegionToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.KeyboardBacklightPage_Title}"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    Initialized="KeyboardBacklightPage_Initialized"
    Scrollable="True">

    <StackPanel Margin="0,0,0,0">

        <TextBlock
            x:Name="_titleTextBlock"
            Margin="0,16,0,24"
            Focusable="True"
            FontSize="24"
            FontWeight="Medium"
            Text="{x:Static resources:Resource.KeyboardBacklightPage_Title}" />

        <custom:CardControl Margin="0,0,8,24">
            <custom:CardControl.Header>
                <controls:CardHeaderControl
                    x:Name="_powerButtonLedHeader"
                    Title="{x:Static resources:Resource.PowerButtonLedSync_Title}"
                    Subtitle="{x:Static resources:Resource.PowerButtonLedSync_Message}" />
            </custom:CardControl.Header>
            <wpfui:ToggleSwitch
                x:Name="_powerButtonLedSyncToggle"
                IsEnabled="False"
                AutomationProperties.Name="{x:Static resources:Resource.PowerButtonLedSync_Title}"
                Click="PowerButtonLedSyncToggle_Click" />
        </custom:CardControl>

        <controls:LoadableControl x:Name="_loader" IndicatorMargin="0,64,0,0">
            <StackPanel x:Name="_content" Margin="0,0,8,0">
                <TextBlock
                    x:Name="_noKeyboardsText"
                    FontSize="14"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{x:Static resources:Resource.KeyboardBacklightPage_NoCompatibleKeyboardsFound}"
                    Visibility="Collapsed" />
            </StackPanel>
        </controls:LoadableControl>

    </StackPanel>

</wpfui:UiPage>
