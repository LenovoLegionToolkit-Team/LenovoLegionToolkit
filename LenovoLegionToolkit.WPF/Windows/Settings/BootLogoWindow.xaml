<local:BaseWindow
    x:Class="LenovoLegionToolkit.WPF.Windows.Settings.BootLogoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LenovoLegionToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:LenovoLegionToolkit.WPF.Controls.Custom"
    xmlns:local="clr-namespace:LenovoLegionToolkit.WPF.Windows"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:LenovoLegionToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.BootLogoWindow_Title}"
    Width="490"
    MinWidth="490"
    MaxWidth="490"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <wpfui:TitleBar
            Grid.Row="0"
            CanMaximize="false"
            ShowMaximize="false"
            ShowMinimize="false"
            UseSnapLayout="false" />

        <Grid
            Grid.Row="0"
            Height="24"
            Margin="12,8,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="12"
                IsHitTestVisible="False"
                Text="{x:Static resources:Resource.BootLogoWindow_Title}" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="12,4,12,0">
            <Border
                x:Name="_previewScreenBorder"
                Margin="0,0,0,8"
                Padding="8,8,8,12"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Border
                    Background="#000000"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    ClipToBounds="True">
                    <Grid>
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="764*" />
                                <RowDefinition Height="236*" />
                            </Grid.RowDefinitions>

                            <Image
                                x:Name="_previewImage"
                                Grid.Row="0"
                                MaxHeight="60"
                                MaxWidth="200"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stretch="Uniform" />
                        </Grid>

                        <Grid HorizontalAlignment="Center" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="360*" />
                                <RowDefinition Height="640*" />
                            </Grid.RowDefinitions>

                            <wpfui:ProgressRing
                                x:Name="_previewSpinner"
                                Grid.Row="1"
                                Width="22"
                                Height="22"
                                Foreground="#E0E0E0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsIndeterminate="True" />
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <custom:CardControl Margin="0,0,0,8" Icon="Image24">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.BootLogoWindow_Status_Title}" Subtitle="{x:Static resources:Resource.BootLogoWindow_Status_Subtitle}" />
                </custom:CardControl.Header>
                <custom:Badge
                    x:Name="_statusBadge"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Padding="8,4"
                    Appearance="Secondary"
                    FontSize="12" />
            </custom:CardControl>

            <custom:CardControl Margin="0,0,0,8" Icon="Info24">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.BootLogoWindow_Requirements_Title}" Subtitle="{x:Static resources:Resource.BootLogoWindow_Requirements_Subtitle}" />
                </custom:CardControl.Header>
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <custom:Badge
                        x:Name="_resolutionBadge"
                        Margin="0,0,8,0"
                        Padding="8,4"
                        Appearance="Secondary"
                        FontSize="12" />
                    <custom:Badge
                        x:Name="_formatsBadge"
                        Padding="8,4"
                        Appearance="Secondary"
                        FontSize="12" />
                </StackPanel>
            </custom:CardControl>

            <custom:CardControl Margin="0,0,0,8" Icon="ArrowClockwise24">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.BootLogoWindow_Options_Title}" Subtitle="{x:Static resources:Resource.BootLogoWindow_Disable_Windows_Animation}" />
                </custom:CardControl.Header>
                <wpfui:ToggleSwitch
                    x:Name="_animationToggle"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="AnimationToggle_Click"
                    AutomationProperties.Name="{x:Static resources:Resource.BootLogoWindow_Disable_Windows_Animation}" />
            </custom:CardControl>

            <custom:InfoBar
                x:Name="_resultInfoBar"
                Margin="0,0,0,8"
                IsClosable="True"
                IsOpen="False" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <wpfui:Button
                x:Name="_revertToDefaultButton"
                Grid.Column="1"
                MinWidth="100"
                Margin="8,0,0,0"
                Appearance="Secondary"
                Click="RevertToDefaultButton_Click"
                Content="{x:Static resources:Resource.RevertToDefault}"
                Icon="ArrowCounterclockwise24"
                Visibility="Collapsed" />

            <wpfui:Button
                x:Name="_customizeButton"
                Grid.Column="2"
                MinWidth="100"
                Margin="8,0,0,0"
                Appearance="Primary"
                Click="CustomizeButton_Click"
                Content="{x:Static resources:Resource.BootLogoWindow_Customize}"
                Icon="FolderOpen24" />

            <wpfui:Button
                Grid.Column="3"
                MinWidth="80"
                Margin="8,0,0,0"
                Appearance="Secondary"
                Click="CloseButton_Click"
                Content="{x:Static resources:Resource.Close}" />
        </Grid>

    </Grid>
</local:BaseWindow>
