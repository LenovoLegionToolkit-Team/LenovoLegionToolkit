<local:BaseWindow
    x:Class="LenovoLegionToolkit.WPF.Windows.Dashboard.GodModeSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LenovoLegionToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:LenovoLegionToolkit.WPF.Controls.Custom"
    xmlns:dashboard="clr-namespace:LenovoLegionToolkit.WPF.Controls.Dashboard"
    xmlns:godMode="clr-namespace:LenovoLegionToolkit.WPF.Controls.Dashboard.GodMode"
    xmlns:local="clr-namespace:LenovoLegionToolkit.WPF.Windows"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:LenovoLegionToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.GodModeSettingsWindow_Title}"
    Width="905"
    Height="700"
    MinWidth="905"
    MinHeight="500"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <wpfui:TitleBar
            Grid.Row="0"
            CanMaximize="false"
            ShowMaximize="false"
            ShowMinimize="false"
            UseSnapLayout="false" />

        <Grid
            Grid.Row="0"
            Height="24"
            Margin="12,8,12,8">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                IsHitTestVisible="False"
                Text="{x:Static resources:Resource.GodModeSettingsWindow_Title}" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="12,0,16,0">
            <custom:InfoBar
                x:Name="_vantageRunningWarningInfoBar"
                Title="{x:Static resources:Resource.GodModeSettingsWindow_VantageWarning_Title}"
                Margin="0,8,0,0"
                IsClosable="False"
                IsOpen="False"
                Severity="Error" />
            <custom:InfoBar
                x:Name="_legionZoneRunningWarningInfoBar"
                Title="{x:Static resources:Resource.GodModeSettingsWindow_LegionZoneWarning_Title}"
                Margin="0,8,0,0"
                IsClosable="False"
                IsOpen="False"
                Severity="Error" />
            <custom:InfoBar
                x:Name="_legionSpaceRunningWarningInfoBar"
                Title="{x:Static resources:Resource.GodModeSettingsWindow_LegionSpaceWarning_Title}"
                Margin="0,8,0,0"
                IsClosable="False"
                IsOpen="False"
                Severity="Error" />
            <custom:InfoBar
                x:Name="_capabilityWarningInfoBar"
                Title="{x:Static resources:Resource.GodModeSettingsWindow_PartialSupport_Message}"
                Margin="0,8,0,0"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="12,16,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label
                Grid.Column="0"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Content="{x:Static resources:Resource.GodModeSettingsWindow_ActivePreset_Title}" />

            <ComboBox
                x:Name="_presetsComboBox"
                Grid.Column="1"
                SelectionChanged="PresetsComboBox_SelectionChanged" />

            <wpfui:Button
                Grid.Column="2"
                Margin="8,0,0,0"
                VerticalAlignment="Stretch"
                Click="EditPresetsButton_Click"
                Icon="Edit24"
                ToolTip="{x:Static resources:Resource.Edit}" />
            <wpfui:Button
                x:Name="_deletePresetsButton"
                Grid.Column="3"
                Margin="8,0,0,0"
                VerticalAlignment="Stretch"
                Click="DeletePresetsButton_Click"
                Icon="Delete24"
                ToolTip="{x:Static resources:Resource.Delete}" />
            <wpfui:Button
                x:Name="_addPresetsButton"
                Grid.Column="4"
                Margin="8,0,0,0"
                VerticalAlignment="Stretch"
                Appearance="Primary"
                Click="AddPresetsButton_Click"
                Content="{x:Static resources:Resource.Add}"
                Icon="Add24" />
        </Grid>

        <controls:LoadableControl
            x:Name="_loader"
            Grid.Row="3"
            Margin="12,0,12,0"
            IndicatorVerticalAlignment="Center">
            <TabControl ItemContainerStyle="{StaticResource SidebarTabItemStyle}" Style="{StaticResource SidebarTabControlStyle}">

                <TabItem x:Name="_cpuTabItem" Visibility="Visible">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <wpfui:SymbolIcon Symbol="DeveloperBoard24" Margin="0,0,8,0" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Static resources:Resource.GodModeSettingsWindow_CPU_Title}"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <godMode:GodModeValueControl
                                x:Name="_cpuLongTermPowerLimitControl"
                                Title="{x:Static resources:Resource.GodModeSettingsWindow_CPU_LongTermPL}"
                                Description="{x:Static resources:Resource.GodModeSettingsWindow_CPU_LongTermPL_Description}"
                                Unit="{x:Static resources:Resource.Watt}" />
                            <godMode:GodModeValueControl
                                x:Name="_cpuShortTermPowerLimitControl"
                                Title="{x:Static resources:Resource.GodModeSettingsWindow_CPU_ShortTermPL}"
                                Description="{x:Static resources:Resource.GodModeSettingsWindow_CPU_ShortTermPL_Description}"
                                Unit="{x:Static resources:Resource.Watt}" />
                            <godMode:GodModeValueControl
                                x:Name="_cpuPeakPowerLimitControl"
                                Title="{x:Static resources:Resource.GodModeSettingsWindow_CPU_PeakPL}"
                                Description="{x:Static resources:Resource.GodModeSettingsWindow_CPU_PeakPL_Description}"
                                Warning="{x:Static resources:Resource.GodModeSettingsWindow_CPU_PeakPL_Warning}"
                                Unit="{x:Static resources:Resource.Watt}" />
                            <godMode:GodModeValueControl
                                x:Name="_cpuCrossLoadingLimitControl"
                                Title="{x:Static resources:Resource.GodModeSettingsWindow_CPU_CrossLoading}"
                                Description="{x:Static resources:Resource.GodModeSettingsWindow_CPU_CrossLoading_Description}"
                                Info="{x:Static resources:Resource.GodModeSettingsWindow_CPU_CrossLoading_Info}"
                                Unit="{x:Static resources:Resource.Watt}" />
                            <godMode:GodModeValueControl
                                x:Name="_cpuPL2TauControl"
                                Title="{x:Static resources:Resource.GodModeSettingsWindow_CPU_PL2Tau}"
                                Description="{x:Static resources:Resource.GodModeSettingsWindow_CPU_PL2Tau_Description}"
                                Unit="s" />
                            <godMode:GodModeValueControl
                                x:Name="_apuSPPTPowerLimitControl"
                                Title="{x:Static resources:Resource.GodModeSettingsWindow_CPU_APUsPPT_PL}"
                                Description="{x:Static resources:Resource.GodModeSettingsWindow_CPU_APUsPPT_PL_Description}"
                                Unit="{x:Static resources:Resource.Watt}" />
                            <godMode:GodModeValueControl
                                x:Name="_cpuTemperatureLimitControl"
                                Title="{x:Static resources:Resource.GodModeSettingsWindow_CPU_TempLimit}"
                                Description="{x:Static resources:Resource.GodModeSettingsWindow_CPU_TempLimit_Description}"
                                Warning="{x:Static resources:Resource.GodModeSettingsWindow_CPU_TempLimit_Warning}"
                                Unit="{x:Static resources:Resource.Celsius}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="_gpuTabItem" Visibility="Visible">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <wpfui:SymbolIcon Symbol="Desktop24" Margin="0,0,8,0" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Static resources:Resource.GodModeSettingsWindow_GPU_Title}"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <godMode:GodModeValueControl
                                x:Name="_gpuPowerBoostControl"
                                Title="{x:Static resources:Resource.GodModeSettingsWindow_GPU_DynamicBoost}"
                                Description="{x:Static resources:Resource.GodModeSettingsWindow_GPU_DynamicBoost_Description}"
                                Unit="{x:Static resources:Resource.Watt}" />
                            <godMode:GodModeValueControl
                                x:Name="_gpuConfigurableTGPControl"
                                Title="{x:Static resources:Resource.GodModeSettingsWindow_GPU_CTGP}"
                                Description="{x:Static resources:Resource.GodModeSettingsWindow_GPU_CTGP_Description}"
                                Unit="{x:Static resources:Resource.Watt}" />
                            <godMode:GodModeValueControl
                                x:Name="_gpuTemperatureLimitControl"
                                Title="{x:Static resources:Resource.GodModeSettingsWindow_GPU_TempLimit}"
                                Description="{x:Static resources:Resource.GodModeSettingsWindow_GPU_TempLimit_Description}"
                                Warning="{x:Static resources:Resource.GodModeSettingsWindow_GPU_TempLimit_Warning}"
                                Unit="{x:Static resources:Resource.Celsius}" />
                            <godMode:GodModeValueControl
                                x:Name="_gpuTotalProcessingPowerTargetOnAcOffsetFromBaselineControl"
                                Title="{x:Static resources:Resource.GodModeSettingsWindow_GPU_TotalProcessingPowerTargetOnAcOffsetFromBaselineControl}"
                                Description="{x:Static resources:Resource.GodModeSettingsWindow_GPU_TotalProcessingPowerTargetOnAcOffsetFromBaselineControl_Description}"
                                Info="{x:Static resources:Resource.GodModeSettingsWindow_GPU_TotalProcessingPowerTargetOnAcOffsetFromBaselineControl_Info}"
                                Unit="{x:Static resources:Resource.Watt}" />
                            <godMode:GodModeValueControl
                                x:Name="_gpuToCpuDynamicBoostControl"
                                Title="{x:Static resources:Resource.GodModeSettingsWindow_GPU_ToCpuDynamicBoostControl}"
                                Description="{x:Static resources:Resource.GodModeSettingsWindow_GPU_ToCpuDynamicBoostControl_Description}"
                                Info="{x:Static resources:Resource.GodModeSettingsWindow_GPU_ToCpuDynamicBoostControl_Info}"
                                Unit="{x:Static resources:Resource.Watt}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="_fanTabItem" Visibility="Visible">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <wpfui:SymbolIcon Symbol="WeatherBlowingSnow24" Margin="0,0,8,0" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Static resources:Resource.GodModeSettingsWindow_Fans_Title}"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <custom:CardControl
                                x:Name="_fanCurveCardControl"
                                Margin="0,0,0,8"
                                AutomationProperties.Name="{x:Static resources:Resource.GodModeSettingsWindow_Fans_Curve_Title}">
                                <custom:CardControl.Header>
                                    <StackPanel x:Name="_fanCurveControlStackPanel">
                                        <controls:CardHeaderControl
                                            Title="{x:Static resources:Resource.GodModeSettingsWindow_Fans_Curve_Title}"
                                            Subtitle="{x:Static resources:Resource.GodModeSettingsWindow_Fans_Curve_Message}"
                                            Info="{x:Static resources:Resource.GodModeSettingsWindow_Fans_Curve_Info}" />
                                        <wpfui:Button
                                            x:Name="_fanCurveButton"
                                            MinWidth="120"
                                            Margin="0,16,0,0"
                                            HorizontalAlignment="Right"
                                            Click="DefaultFanCurve_Click"
                                            Content="{x:Static resources:Resource.Default}"
                                            Icon="ArrowClockwise24" />
                                    </StackPanel>
                                </custom:CardControl.Header>
                            </custom:CardControl>

                            <custom:CardControl x:Name="_fanFullSpeedCardControl" Margin="0,0,0,8">
                                <custom:CardControl.Header>
                                    <controls:CardHeaderControl
                                        Title="{x:Static resources:Resource.GodModeSettingsWindow_Fans_Max_Title}"
                                        Subtitle="{x:Static resources:Resource.GodModeSettingsWindow_Fans_Max_Message}"
                                        Warning="{x:Static resources:Resource.GodModeSettingsWindow_Fans_Max_Warning}" />
                                </custom:CardControl.Header>
                                <wpfui:ToggleSwitch
                                    x:Name="_fanFullSpeedToggle"
                                    Margin="0,0,0,8"
                                    AutomationProperties.Name="{x:Static resources:Resource.GodModeSettingsWindow_Fans_Max_Title}"
                                    Click="FanFullSpeedToggle_Click" />
                            </custom:CardControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="_fnqTabItem" Visibility="Collapsed">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <wpfui:SymbolIcon Symbol="Gauge24" Margin="0,0,8,0" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Static resources:Resource.ITSModeConfigWindow_Title}"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                    </TabItem.Header>
                    <dashboard:ITSModeLoopControl x:Name="_fnqLoopControl" Margin="0,0,8,0" />
                </TabItem>

                <TabItem x:Name="_pboTabItem" Visibility="Collapsed">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <wpfui:SymbolIcon Symbol="TopSpeed24" Margin="0,0,8,0" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Static resources:Resource.GodModeSettingsWindow_Toggle_OC_Title}"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <custom:CardControl x:Name="_toggleOcCard" Margin="0,0,0,8">
                                <custom:CardControl.Header>
                                    <controls:CardHeaderControl
                                        Title="{x:Static resources:Resource.GodModeSettingsWindow_Toggle_OC_Title}"
                                        Subtitle="{x:Static resources:Resource.GodModeSettingsWindow_Toggle_OC_Message}"
                                        Warning="{x:Static resources:Resource.GodModeSettingsWindow_Toggle_OC_Warning}" />
                                </custom:CardControl.Header>
                                <wpfui:ToggleSwitch
                                    x:Name="_overclockingToggle"
                                    Margin="0,0,0,8"
                                    AutomationProperties.Name="{x:Static resources:Resource.GodModeSettingsWindow_Toggle_OC_Title}"
                                    Click="OverclockingToggle_Click" />
                            </custom:CardControl>

                            <godMode:GodModeValueControl
                                x:Name="_cpuPrecisionBoostOverdriveScaler"
                                Title="{x:Static resources:Resource.GodModeSettingsWindow_PrecisionBoostOverdriveScaler_Title}"
                                Description="{x:Static resources:Resource.GodModeSettingsWindow_PrecisionBoostOverdriveScaler_Description}"
                                Unit="x" />
                            <godMode:GodModeValueControl
                                x:Name="_cpuPrecisionBoostOverdriveBoostFrequency"
                                Title="{x:Static resources:Resource.GodModeSettingsWindow_PrecisionBoostOverdriveBoostFrequency_Title}"
                                Description="{x:Static resources:Resource.GodModeSettingsWindow_PrecisionBoostOverdriveBoostFrequency_Description}"
                                Unit="{x:Static resources:Resource.MHz}" />

                            <custom:CardControl x:Name="_toggleCoreCurveCard" Margin="0,0,0,8">
                                <custom:CardControl.Header>
                                    <controls:CardHeaderControl Title="{x:Static resources:Resource.GodModeSettingsWindow_Toggle_CoreCurve_Title}" Subtitle="{x:Static resources:Resource.GodModeSettingsWindow_Toggle_CoreCurve_Message}" />
                                </custom:CardControl.Header>
                                <wpfui:ToggleSwitch
                                    x:Name="_coreCurveToggle"
                                    Margin="0,0,0,8"
                                    AutomationProperties.Name="{x:Static resources:Resource.GodModeSettingsWindow_Toggle_CoreCurve_Title}"
                                    Click="CoreCurveToggle_Click" />
                            </custom:CardControl>

                            <godMode:GodModeValueControl
                                x:Name="_cpuAllCoreCurveOptimizer"
                                Title="{x:Static resources:Resource.GodModeSettingsWindow_AllCoreCurveOptimizer_Title}"
                                Description="{x:Static resources:Resource.GodModeSettingsWindow_AllCoreCurveOptimizer_Description}"
                                Info="{x:Static resources:Resource.GodModeSettingsWindow_AllCoreCurveOptimizer_Info}"
                                Unit="x" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="_advancedTabItem" Visibility="Visible">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <wpfui:SymbolIcon Symbol="WrenchScrewdriver24" Margin="0,0,8,0" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Static resources:Resource.GodModeSettingsWindow_Advanced_Title}"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.Resources>
                                    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource SystemAccentColorSecondary}" />
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <wpfui:SymbolIcon
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Filled="False"
                                    Foreground="{StaticResource AccentBrush}"
                                    Symbol="Info24" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource AccentBrush}"
                                    Text="{x:Static resources:Resource.GodModeSettingsWindow_Advanced_Message}"
                                    TextWrapping="Wrap" />
                            </Grid>

                             <custom:CardControl x:Name="_maxValueOffsetCardControl" Margin="0,0,0,8">
                                <custom:CardControl.Header>
                                    <controls:CardHeaderControl
                                        Title="{x:Static resources:Resource.GodModeSettingsWindow_Advanced_MaxOffset_Title}"
                                        Subtitle="{x:Static resources:Resource.GodModeSettingsWindow_Advanced_MaxOffset_Message}"
                                        Warning="{x:Static resources:Resource.GodModeSettingsWindow_Advanced_MaxOffset_Warning}" />
                                </custom:CardControl.Header>
                                <wpfui:NumberBox
                                    x:Name="_maxValueOffsetNumberBox"
                                    Width="120"
                                    Margin="32,0,0,0"
                                    AutomationProperties.Name="{x:Static resources:Resource.GodModeSettingsWindow_Advanced_MaxOffset_Title}"
                                    ClearButtonEnabled="False"
                                    MaxDecimalPlaces="0"
                                    Maximum="255"
                                    Minimum="-255" />
                            </custom:CardControl>

                            <custom:CardControl x:Name="_minValueOffsetCardControl" Margin="0,0,0,8">
                                <custom:CardControl.Header>
                                    <controls:CardHeaderControl
                                        Title="{x:Static resources:Resource.GodModeSettingsWindow_Advanced_MinOffset_Title}"
                                        Subtitle="{x:Static resources:Resource.GodModeSettingsWindow_Advanced_MinOffset_Message}"
                                        Warning="{x:Static resources:Resource.GodModeSettingsWindow_Advanced_MinOffset_Warning}" />
                                </custom:CardControl.Header>
                                <wpfui:NumberBox
                                    x:Name="_minValueOffsetNumberBox"
                                    Width="120"
                                    Margin="32,0,0,0"
                                    AutomationProperties.Name="{x:Static resources:Resource.GodModeSettingsWindow_Advanced_MinOffset_Title}"
                                    ClearButtonEnabled="False"
                                    MaxDecimalPlaces="0"
                                    Maximum="255"
                                    Minimum="-255" />
                            </custom:CardControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </controls:LoadableControl>

        <Grid
            x:Name="_buttonsStackPanel"
            Grid.Row="4"
            Margin="12"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <wpfui:Button
                x:Name="_loadButton"
                Grid.Column="0"
                MinWidth="120"
                Click="LoadButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Static resources:Resource.Load}" />
                    <wpfui:SymbolIcon
                        x:Name="_loadButtonIcon"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Symbol="ChevronDown24" />
                </Grid>
            </wpfui:Button>

            <wpfui:Button
                Grid.Column="2"
                MinWidth="120"
                Click="SaveButton_Click"
                Content="{x:Static resources:Resource.Save}" />
            <wpfui:Button
                Grid.Column="3"
                MinWidth="120"
                Margin="12,0,0,0"
                Appearance="Primary"
                Click="SaveAndCloseButton_Click"
                Content="{x:Static resources:Resource.SaveAndClose}" />
        </Grid>

        <wpfui:Snackbar
            x:Name="_snackBar"
            Grid.Row="3"
            HorizontalAlignment="Center"
            CloseButtonEnabled="True"
            Icon="ErrorCircle24"
            Timeout="5000" />
    </Grid>
</local:BaseWindow>
