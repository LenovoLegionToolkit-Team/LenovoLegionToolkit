<UserControl
    x:Class="LenovoLegionToolkit.WPF.Controls.Dashboard.ITSModeLoopControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:custom="clr-namespace:LenovoLegionToolkit.WPF.Controls.Custom"
    xmlns:behaviors="clr-namespace:LenovoLegionToolkit.WPF.Behaviors">

    <StackPanel>
        <custom:HintText
            Margin="0,0,0,8"
            Text="{x:Static resources:Resource.ITSModeConfigWindow_Description}" />

        <StackPanel
            x:Name="_modeCardsPanel"
            Margin="0,0,8,0"
            behaviors:DragDropBehavior.IsEnabled="True"
            behaviors:DragDropBehavior.DragHandleName="DragHandle" />
    </StackPanel>
</UserControl>
