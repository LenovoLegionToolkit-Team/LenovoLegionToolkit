<controls:AbstractRefreshingControl
    x:Class="LenovoLegionToolkit.WPF.Controls.Dashboard.PowerButtonLedControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LenovoLegionToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:LenovoLegionToolkit.WPF.Controls.Custom"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <custom:CardControl Margin="0,0,0,8" Icon="Power24">
        <custom:CardControl.Header>
            <controls:CardHeaderControl Title="{x:Static resources:Resource.PowerButtonLed_Title}" Subtitle="{x:Static resources:Resource.PowerButtonLed_Message}" />
        </custom:CardControl.Header>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <Slider
                x:Name="_brightnessSlider"
                Width="140"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Static resources:Resource.PowerButtonLed_Brightness}"
                IsSnapToTickEnabled="True"
                TickFrequency="1"
                TickPlacement="BottomRight"
                ToolTip="{x:Static resources:Resource.PowerButtonLed_Brightness}"
                ValueChanged="BrightnessSlider_ValueChanged"
                Visibility="Hidden" />
            <wpfui:ToggleSwitch
                x:Name="_toggle"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Static resources:Resource.PowerButtonLed_Message}"
                Click="Toggle_Click"
                Visibility="Hidden" />
        </StackPanel>
    </custom:CardControl>
</controls:AbstractRefreshingControl>
