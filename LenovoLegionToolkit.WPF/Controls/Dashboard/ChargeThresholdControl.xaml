<controls:AbstractRefreshingControl
    x:Class="LenovoLegionToolkit.WPF.Controls.Dashboard.ChargeThresholdControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LenovoLegionToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:LenovoLegionToolkit.WPF.Controls.Custom"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <custom:CardControl Margin="0,0,0,8" Icon="BatteryCharge24">
        <custom:CardControl.Header>
            <controls:CardHeaderControl x:Name="_cardHeaderControl" Subtitle="{x:Static resources:Resource.ChargeThresholdControl_Message}" Title="{x:Static resources:Resource.ChargeThresholdControl_Title}" />
        </custom:CardControl.Header>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <StackPanel Width="200" VerticalAlignment="Center">
                <custom:RangeSlider
                    x:Name="_rangeSlider"
                    StartName="{x:Static resources:Resource.ChargeThresholdControl_Start}"
                    StopName="{x:Static resources:Resource.ChargeThresholdControl_Stop}"
                    ValueChanged="RangeSlider_ValueChanged"
                    ValueCommitted="RangeSlider_ValueCommitted"
                    Visibility="Hidden" />
                <Grid Margin="0,4,0,0">
                    <TextBlock
                        x:Name="_startTextBlock"
                        HorizontalAlignment="Left"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Name="_stopTextBlock"
                        HorizontalAlignment="Right"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </StackPanel>
            <wpfui:ToggleSwitch
                x:Name="_toggle"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Click="Toggle_Click"
                Visibility="Hidden" />
        </StackPanel>
    </custom:CardControl>
</controls:AbstractRefreshingControl>
